# Webhook do agente de triagem (repo kll-promotora-n8n-agent), consumido só
# pelo Route Handler server-side em src/app/api/chat/route.ts — nunca chega
# ao bundle do cliente. Sem esta variável, o widget do hero mostra o erro de
# "assistente indisponível" em vez de conversar de verdade.
N8N_WEBHOOK_URL=
